{
  "name": "dsh-media-generation",
  "version": "0.1.4",
  "description": "Configurable image and video generation tools for DeepSeek Harness",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "src",
    "client.js",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "docs/poster/deepimage-banner-1280.png"
  ],
  "license": "MIT",
  "scripts": {
    "pack:plugin": "npm pack --pack-destination dist"
  },
  "engines": {
    "dsh": ">=0.2.1-alpha.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh": "0.2.1-rc.5",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.5",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.5",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "deepImageEdition": "open-source",
  "pnpm": {
    "overrides": {
      "@deepseek-ai/dsh-otel>@opentelemetry/api": "1.9.1"
    }
  }
}
